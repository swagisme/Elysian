@model List<Elysian.Models.Order>

@{
    ViewData["Title"] = "Order History";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold display-5 text-dark">
            📋 Your <span class="text-rose">Order History</span>
        </h2>
        <p class="text-muted">View all your past orders and their status</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-light border shadow-sm p-5 text-center rounded-3">
            <div class="mb-4">
                <i class="bi bi-cart-x" style="font-size: 3rem; color: #6c757d;"></i>
            </div>
            <h5 class="mb-3">No orders found</h5>
            <p class="text-muted mb-4">You haven't placed any orders yet.</p>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-dark px-4 py-2">
                Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-dark rounded-top">
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th>Items</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th>Tracking</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr class="border-bottom">
                                    <td class="fw-semibold">#@order.Id</td>
                                    <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td>@order.Items.Count item(s)</td>
                                    <td class="fw-bold text-rose">Rs. @order.TotalAmount</td>
                                    <td>
                                        @{
                                            var badgeClass = order.Status switch
                                            {
                                                "Pending" => "bg-warning text-dark",
                                                "Processing" => "bg-info text-white",
                                                "Shipped" => "bg-primary text-white",
                                                "Delivered" => "bg-success text-white",
                                                "Cancelled" => "bg-danger text-white",
                                                _ => "bg-secondary text-white"
                                            };
                                        }
                                        <span class="badge @badgeClass">@order.Status</span>
                                    </td>
                                    <td class="font-monospace">@order.TrackingNumber</td>
                                    <td>
                                        <a asp-action="OrderDetails" asp-route-id="@order.Id"
                                           class="btn btn-sm btn-outline-dark rounded-pill px-3">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>