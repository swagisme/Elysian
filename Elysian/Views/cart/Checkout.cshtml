@model Elysian.Models.CheckoutViewModel

<div class="container my-5">
    <div class="row g-4">
        <!-- Checkout Form -->
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-4" style="background:#fffaf0;">
                <h3 class="fw-bold mb-4" style="color:#333; font-family:'Playfair Display', serif;">
                    📝 Checkout Details
                </h3>

                <form asp-action="Checkout" method="post">
                    @Html.AntiForgeryToken()

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold" style="color:#444;"></label>
                        <input asp-for="FullName"
                               class="form-control rounded-3 shadow-sm border-0"
                               style="background:#f8f5ef;" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold" style="color:#444;"></label>
                        <input asp-for="Email"
                               class="form-control rounded-3 shadow-sm border-0"
                               style="background:#f8f5ef;" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Phone -->
                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label fw-semibold" style="color:#444;"></label>
                        <input asp-for="Phone"
                               class="form-control rounded-3 shadow-sm border-0"
                               style="background:#f8f5ef;" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <!-- Address -->
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label fw-semibold" style="color:#444;"></label>
                        <textarea asp-for="Address"
                                  class="form-control rounded-3 shadow-sm border-0"
                                  style="background:#f8f5ef;"></textarea>
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <!-- Place Order Button -->
                    <button type="submit"
                            class="btn w-100 rounded-pill py-2 fw-semibold"
                            style="background:#DEB64B; color:#fff; letter-spacing:0.5px;">
                        Place Order
                    </button>
                </form>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 p-4" style="background:#fffaf0;">
                <h3 class="fw-bold mb-4" style="color:#333; font-family:'Playfair Display', serif;">
                    🛍️ Your Order
                </h3>

                <div class="table-responsive">
                    <table class="table align-middle table-borderless">
                        <thead style="background:#f8f5ef; color:#444; font-weight:600;">
                            <tr>
                                <th>Product</th>
                                <th>Qty</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Cart != null && Model.Cart.Items != null && Model.Cart.Items.Any())
                            {
                                foreach (var item in Model.Cart.Items)
                                {
                                    <tr class="border-bottom">
                                        <td class="fw-semibold">@item.Product.Name</td>
                                        <td>@item.Quantity</td>
                                        <td class="fw-bold text-dark">
                                            Rs. @(item.Product.Price * item.Quantity)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3">Your cart is empty.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="text-end mt-3">
                    <h4 class="fw-bold" style="font-family:'Playfair Display', serif; color:#222;">
                        Total: <span style="color:#DEB64B;">
                            Rs. @(Model.Cart != null ? Model.Cart.Items.Sum(i => i.Product.Price * i.Quantity) : 0)
                        </span>
                    </h4>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
