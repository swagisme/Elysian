<head>
    <style>
        .hero-banner {
            min-height: 100vh;
            background: linear-gradient(to right, #fdfaf8, #fff8e7);
            display: flex;
            align-items: center;
            padding: 80px 0;
        }

        .hero-title {
            font-size: 3.5rem;
            font-weight: 700;
            color: #1c1c1c;
        }

        .btn-rose-gold {
            background: linear-gradient(135deg, #DEB64B, #caa94a);
            color: #fff;
            border-radius: 30px;
            padding: 14px 36px;
            font-size: 1rem;
            box-shadow: 0px 6px 15px rgba(222,182,75,0.3);
