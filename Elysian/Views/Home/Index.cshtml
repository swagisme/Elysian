<script>
    // Open product modal
    function openModal(product) {
        document.getElementById(product + '-modal').style.display = 'block';
    }

    // Close product modal
    function closeModal(product) {
        document.getElementById(product + '-modal').style.display = 'none';
    }

    // Add product to cart using AJAX
    function addToCart(productId, productName, quantity) {
        quantity = parseInt(quantity);
        if (quantity < 1) quantity = 1;

        $.ajax({
            url: '/Cart/AddToCart', // Your controller/action
            type: 'POST',
            data: { productId: productId, quantity: quantity },
            success: function () {
                // Reload cart summary in navbar dynamically
                $("#cart-summary").load("/Home/CartSummary");
                // Optional: show success message
                alert(`${productName} (x${quantity}) added to cart!`);
            },
            error: function () {
                alert("Failed to add item to cart.");
            }
        });
    }

    // Close modal when clicking outside of it
    window.onclick = function (event) {
        document.querySelectorAll('.product-modal').forEach(function (modal) {
            if (event.target === modal) {
                modal.style.display = "none";
            }
        });
    };
</script>

