@model IEnumerable<Elysian.Models.Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "_AdminLayout";
}

<div class="admin-content">
    <h1>Orders</h1>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Total Items</th>
                <th>Total Price</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.Id</td>
                    <td>@(order.User != null ? order.User.FullName : "Guest")</td>
                    <td>@order.Items.Sum(i => i.Quantity)</td>
                    <td>
                        $@order.Items.Sum(i => i.Quantity * i.UnitPrice)
                    </td>
                    <td>@order.Status</td>
                    <td>
                        <a asp-action="OrderDetails"
                           asp-controller="Admin"
                           asp-route-id="@order.Id"
                           class="btn btn-sm btn-primary">
                            View
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
