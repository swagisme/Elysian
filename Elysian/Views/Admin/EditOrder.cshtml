@model Elysian.Models.Order
@{
    ViewData["Title"] = "Edit Order";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-10 col-lg-12">
            <div class="card card-order shadow-lg border-0">
                <!-- Card Header with Order Info -->
                <div class="card-header py-4 px-5" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border-radius: 15px 15px 0 0;">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="text-white mb-2">
                                <i class="fas fa-receipt me-3"></i>Order #@Model.Id
                            </h1>
                            <div class="d-flex align-items-center flex-wrap gap-3">
                                <span class="badge @GetStatusBadgeClass(Model.Status) rounded-pill py-2 px-3">
                                    <i class="fas fa-circle me-1" style="font-size: 0.6em;"></i> @Model.Status
                                </span>
                                <span class="text-white">
                                    <i class="fas fa-calendar me-2"></i>@Model.OrderDate.ToString("MMMM dd, yyyy hh:mm tt")
                                </span>
                            </div>
                        </div>
                        <a asp-action="Orders" class="btn btn-light btn-sm rounded-pill px-4">
                            <i class="fas fa-arrow-left me-2"></i>Back to Orders
                        </a>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="card-body p-5" style="background-color: #f8fafc;">
                    <div class="row g-4">
                        <!-- Left Column - Order Details -->
                        <div class="col-lg-8">
                            <!-- Customer Information Card -->
                            <div class="card shadow-sm border-0 mb-4">
                                <div class="card-header bg-white py-3">
                                    <h5 class="mb-0 text-primary">
                                        <i class="fas fa-user-circle me-2"></i>Customer Information
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small mb-1">
                                                    <i class="fas fa-user me-2"></i>Full Name
                                                </label>
                                                <p class="fw-bold mb-0">@(Model.User != null ? Model.User.FullName : Model.FullName ?? "Guest")</p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small mb-1">
                                                    <i class="fas fa-envelope me-2"></i>Email
                                                </label>
                                                <p class="fw-bold mb-0">@(Model.Email ?? "N/A")</p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small mb-1">
                                                    <i class="fas fa-phone me-2"></i>Phone
                                                </label>
                                                <p class="fw-bold mb-0">@(Model.Phone ?? "N/A")</p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small mb-1">
                                                    <i class="fas fa-map-marker-alt me-2"></i>Address
                                                </label>
                                                <p class="fw-bold mb-0">@(Model.Address ?? "N/A")</p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small mb-1">
                                                    <i class="fas fa-barcode me-2"></i>Tracking Number
                                                </label>
                                                <p class="fw-bold mb-0">@(Model.TrackingNumber ?? "Not Assigned")</p>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="info-item">
                                                <label class="text-muted small mb-1">
                                                    <i class="fas fa-money-bill-wave me-2"></i>Total Amount
                                                </label>
                                                <p class="fw-bold mb-0 text-success fs-5">Rs. @Model.TotalAmount.ToString("N2")</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Order Items Card -->
                            <div class="card shadow-sm border-0">
                                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 text-primary">
                                        <i class="fas fa-shopping-bag me-2"></i>Order Items (@Model.Items.Count)
                                    </h5>
                                    <span class="badge bg-primary rounded-pill py-2 px-3">
                                        <i class="fas fa-box me-1"></i> @Model.Items.Sum(i => i.Quantity) Items
                                    </span>
                                </div>
                                <div class="card-body p-4">
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle">
                                            <thead style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
                                                <tr>
                                                    <th class="border-0">Product</th>
                                                    <th class="border-0 text-center">Quantity</th>
                                                    <th class="border-0 text-center">Unit Price</th>
                                                    <th class="border-0 text-end">Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.Items)
                                                {
                                                    <tr class="order-item-row">
                                                        <td>
                                                            <div class="d-flex align-items-center">
                                                                @if (!string.IsNullOrEmpty(item.Product?.ImageUrl))
                                                                {
                                                                    <img src="@item.Product.ImageUrl" 
                                                                         class="rounded me-3" 
                                                                         style="width: 50px; height: 50px; object-fit: cover;" 
                                                                         alt="@item.Product.Name" />
                                                                }
                                                                <div>
                                                                    <h6 class="mb-0 fw-bold">@item.Product?.Name</h6>
                                                                    <small class="text-muted">ID: @item.ProductId</small>
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="badge bg-light text-dark rounded-pill py-2 px-3">
                                                                <i class="fas fa-times me-1"></i>@item.Quantity
                                                            </span>
                                                        </td>
                                                        <td class="text-center">
                                                            <span class="fw-bold">Rs. @item.UnitPrice.ToString("N2")</span>
                                                        </td>
                                                        <td class="text-end">
                                                            <span class="fw-bold text-success">Rs. @((item.Quantity * item.UnitPrice).ToString("N2"))</span>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                            <tfoot style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);">
                                                <tr>
                                                    <td colspan="3" class="text-end fw-bold border-0">Subtotal:</td>
                                                    <td class="text-end fw-bold border-0">Rs. @Model.Items.Sum(i => i.Quantity * i.UnitPrice).ToString("N2")</td>
                                                </tr>
                                                <tr>
                                                    <td colspan="3" class="text-end fw-bold border-0">Shipping:</td>
                                                    <td class="text-end fw-bold border-0">Rs. 0.00</td>
                                                </tr>
                                                <tr>
                                                    <td colspan="3" class="text-end fw-bold border-0 fs-5">Total:</td>
                                                    <td class="text-end fw-bold border-0 fs-5 text-success">Rs. @Model.TotalAmount.ToString("N2")</td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right Column - Status Update -->
                        <div class="col-lg-4">
                            <div class="card shadow-sm border-0 sticky-top" style="top: 20px;">
                                <div class="card-header bg-white py-3">
                                    <h5 class="mb-0 text-primary">
                                        <i class="fas fa-sync-alt me-2"></i>Update Order Status
                                    </h5>
                                </div>
                                <div class="card-body p-4">
                                    <form method="post"
                                          asp-action="UpdateOrderStatus"
                                          asp-controller="Admin"
                                          asp-route-id="@Model.Id"
                                          class="needs-validation"
                                          novalidate>
                                        @Html.AntiForgeryToken()

                                        <div class="mb-4">
                                            <label class="form-label fw-bold mb-3">
                                                <i class="fas fa-flag me-2 text-primary"></i>Current Status
                                            </label>
                                            <div class="current-status-display p-3 rounded-3 mb-4" style="background-color: @GetStatusColor(Model.Status);">
                                                <div class="d-flex align-items-center">
                                                    <div class="status-icon me-3">
                                                        @switch (Model.Status)
                                                        {
                                                            case "Pending":
                                                                <i class="fas fa-clock fa-2x text-white"></i>
                                                                break;
                                                            case "Shipped":
                                                                <i class="fas fa-shipping-fast fa-2x text-white"></i>
                                                                break;
                                                            case "Delivered":
                                                                <i class="fas fa-check-circle fa-2x text-white"></i>
                                                                break;
                                                            default:
                                                                <i class="fas fa-box fa-2x text-white"></i>
                                                                break;
                                                        }
                                                    </div>
                                                    <div>
                                                        <h4 class="text-white mb-0">@Model.Status</h4>
                                                        <small class="text-white-50">Last updated: @DateTime.Now.ToString("MMM dd, yyyy")</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mb-4">
                                            <label for="statusSelect" class="form-label fw-bold mb-3">
                                                <i class="fas fa-edit me-2 text-primary"></i>Change Status To
                                            </label>
                                            <select name="status" 
                                                    id="statusSelect" 
                                                    class="form-select form-select-lg"
                                                    style="border-radius: 10px; padding: 0.75rem 1rem;">
                                                <option value="Pending" selected="@(Model.Status=="Pending")" data-color="#ffc107" data-icon="clock">
                                                    <i class="fas fa-clock me-2"></i>Pending
                                                </option>
                                                <option value="Processing" selected="@(Model.Status=="Processing")" data-color="#17a2b8" data-icon="cogs">
                                                    <i class="fas fa-cogs me-2"></i>Processing
                                                </option>
                                                <option value="Shipped" selected="@(Model.Status=="Shipped")" data-color="#007bff" data-icon="shipping-fast">
                                                    <i class="fas fa-shipping-fast me-2"></i>Shipped
                                                </option>
                                                <option value="Delivered" selected="@(Model.Status=="Delivered")" data-color="#28a745" data-icon="check-circle">
                                                    <i class="fas fa-check-circle me-2"></i>Delivered
                                                </option>
                                                <option value="Cancelled" selected="@(Model.Status=="Cancelled")" data-color="#dc3545" data-icon="times-circle">
                                                    <i class="fas fa-times-circle me-2"></i>Cancelled
                                                </option>
                                            </select>
                                        </div>

                                        <div class="mb-4">
                                            <label for="statusNotes" class="form-label fw-bold mb-3">
                                                <i class="fas fa-sticky-note me-2 text-primary"></i>Notes (Optional)
                                            </label>
                                            <textarea name="notes" 
                                                      id="statusNotes" 
                                                      class="form-control" 
                                                      rows="3" 
                                                      placeholder="Add any notes about this status change..."
                                                      style="border-radius: 10px;"></textarea>
                                        </div>

                                        <div class="d-grid gap-3">
                                            <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-lg py-3" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); border: none;">
                                                <i class="fas fa-save me-2"></i>Update Status
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-lg rounded-pill py-3" onclick="window.location.reload()">
                                                <i class="fas fa-redo me-2"></i>Reset
                                            </button>
                                        </div>

                                        <div class="mt-4">
                                            <div class="alert alert-info rounded-3 border-0" style="background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);">
                                                <div class="d-flex align-items-center">
                                                    <i class="fas fa-info-circle fa-lg me-3 text-primary"></i>
                                                    <div>
                                                        <h6 class="mb-1 text-primary">Status Update Information</h6>
                                                        <p class="mb-0 small text-muted">Updating the status will notify the customer via email and update the order history.</p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Processing" => "bg-info",
            "Shipped" => "bg-primary",
            "Delivered" => "bg-success",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    string GetStatusColor(string status)
    {
        return status switch
        {
            "Pending" => "#fff3cd",
            "Processing" => "#d1ecf1",
            "Shipped" => "#d1e7ff",
            "Delivered" => "#d4edda",
            "Cancelled" => "#f8d7da",
            _ => "#e2e3e5"
        };
    }
}

@section Styles {
    <style>
        .card-order {
            border-radius: 20px;
            overflow: hidden;
            border: none;
        }

        .info-item {
            padding: 0.75rem;
            border-radius: 10px;
            background-color: #fff;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }

        .info-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
            border-color: #4facfe;
        }

        .order-item-row {
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }

        .order-item-row:hover {
            background-color: #f8fafc;
            border-left: 3px solid #4facfe;
            transform: translateX(5px);
        }

        .table th {
            font-weight: 600;
            color: #475569;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            border-bottom: 2px solid #e2e8f0;
        }

        .table td {
            border-bottom: 1px solid #f1f5f9;
            padding: 1rem 0.75rem;
            vertical-align: middle;
        }

        .form-select {
            border-radius: 10px;
            border: 2px solid #e2e8f0;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .form-select:focus {
            border-color: #4facfe;
            box-shadow: 0 0 0 0.25rem rgba(79, 172, 254, 0.25);
            transform: translateY(-2px);
        }

        .current-status-display {
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

        .current-status-display:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        }

        .btn-primary {
            transition: all 0.3s ease;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .btn-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(79, 172, 254, 0.3);
        }

        .btn-outline-secondary:hover {
            transform: translateY(-3px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

        .badge {
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        .sticky-top {
            position: sticky;
            z-index: 1020;
        }

        /* Status option styling */
        .form-select option {
            padding: 0.5rem;
            border-radius: 5px;
            margin: 2px 0;
        }

        .form-select option:hover {
            background-color: #f1f5f9 !important;
        }

        /* Scrollbar styling */
        .table-responsive::-webkit-scrollbar {
            height: 8px;
        }

        .table-responsive::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .table-responsive::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 10px;
        }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }

        /* Animation for status change */
        @@keyframes statusPulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); }
            100% { transform: scale(1); }
        }

        .current-status-display {
            animation: statusPulse 2s infinite;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .card-header h1 {
                font-size: 1.5rem;
            }
            
            .table-responsive {
                font-size: 0.9rem;
            }
            
            .sticky-top {
                position: static;
            }
        }

        /* Print styles */
        @@media print {
            .btn, .form-control, .form-select, .alert {
                display: none !important;
            }
            
            .card {
                border: 1px solid #000 !important;
                box-shadow: none !important;
            }
        }
    </style>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Status selection change effect
            $('#statusSelect').change(function() {
                var selectedOption = $(this).find('option:selected');
                var statusColor = selectedOption.data('color');
                var statusIcon = selectedOption.data('icon');
                
                // Update status display preview
                $('.current-status-display').css('background-color', statusColor);
                
                // Update icon
                var iconClass = 'fas fa-' + statusIcon;
                $('.current-status-display .status-icon i').attr('class', iconClass + ' fa-2x text-white');
                
                // Update text
                $('.current-status-display h4').text(selectedOption.text().trim());
            });

            // Form validation
            $('form').on('submit', function (e) {
                if (!this.checkValidity()) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $(this).addClass('was-validated');
            });

            // Add hover effects to table rows
            $('.order-item-row').hover(
                function() {
                    $(this).css('transform', 'translateX(5px)');
                },
                function() {
                    $(this).css('transform', 'translateX(0)');
                }
            );

            // Print order functionality
            $('#printOrder').click(function() {
                window.print();
            });

            // Copy tracking number
            $('#copyTracking').click(function() {
                var trackingNumber = '@Model.TrackingNumber';
                if (trackingNumber && trackingNumber !== 'Not Assigned') {
                    navigator.clipboard.writeText(trackingNumber).then(function() {
                        alert('Tracking number copied to clipboard!');
                    });
                }
            });

            // Real-time status update indicator
            $('form').submit(function() {
                $('.btn-primary').html('<i class="fas fa-spinner fa-spin me-2"></i>Updating...');
                $('.btn-primary').prop('disabled', true);
            });
        });
    </script>
}