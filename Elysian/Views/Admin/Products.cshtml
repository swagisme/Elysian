@model List<Elysian.Models.Product>

@{
    ViewData["Title"] = "Manage Products";
    Layout = "_AdminLayout";
}

<h2>Manage Products</h2>

<form asp-action="BulkUpdate"
      asp-controller="Admin"
      method="post"
      enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="table-responsive">
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Image</th>
                    <th class="text-center">Featured</th>
                    <th class="text-center">New</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td>
                            <input type="hidden" name="products[@i].Id" value="@Model[i].Id" />
                            <input class="form-control" name="products[@i].Name" value="@Model[i].Name" required />
                        </td>

                        <td>
                            <input type="number" step="0.01" class="form-control"
                                   name="products[@i].Price" value="@Model[i].Price" required />
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(Model[i].ImageUrl))
                            {
                                <img src="@Model[i].ImageUrl" width="60" class="img-thumbnail mb-1" alt="@Model[i].Name" />
                                <br />
                                <label>
                                    <input type="checkbox" name="products[@i].RemoveImage" value="true" /> Remove
                                </label>
                            }
                            <input type="file" name="ProductImages" class="form-control mt-1" accept="image/*" />
                        </td>

                        <td class="text-center">
                            <input type="hidden" name="products[@i].IsFeatured" value="false" />
                            <input type="checkbox" name="products[@i].IsFeatured" value="true"
                            @(Model[i].IsFeatured ? "checked" : "") />
                        </td>

                        <td class="text-center">
                            <input type="hidden" name="products[@i].IsNewArrival" value="false" />
                            <input type="checkbox" name="products[@i].IsNewArrival" value="true"
                            @(Model[i].IsNewArrival ? "checked" : "") />
                        </td>

                        <td>
                            <a asp-action="EditProduct" asp-route-id="@Model[i].Id"
                               class="btn btn-sm btn-info mb-1">Edit</a>

                            <button type="button" class="btn btn-sm btn-danger mb-1"
                                    onclick="deleteProduct(@Model[i].Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success">💾 Save Changes</button>
        <a asp-action="CreateProduct" class="btn btn-primary ms-2">➕ Add Product</a>
    </div>
</form>

@section Styles {
    <style>
        table th {
            background: linear-gradient(135deg, #1f2937, #111827);
            color: #fff;
            font-size: 14px;
        }

        table td {
            font-size: 13px;
            vertical-align: middle;
        }

        .img-thumbnail {
            object-fit: cover;
            border-radius: 6px;
        }

        .form-control {
            font-size: 13px;
        }

        .btn-sm {
            font-size: 12px;
            padding: 4px 8px;
        }
    </style>
}

@section Scripts {
    <script>
        function deleteProduct(id) {
            if (confirm('Are you sure you want to delete this product?')) {
                // Create a form element
                const form = document.createElement('form');
                form.method = 'post';
                form.action = '@Url.Action("DeleteProduct", "Admin")/' + id;

                // Add anti-forgery token
                const token = document.createElement('input');
                token.type = 'hidden';
                token.name = '__RequestVerificationToken';

                // Get the anti-forgery token from the main form
                const mainFormToken = document.querySelector('input[name="__RequestVerificationToken"]');
                if (mainFormToken) {
                    token.value = mainFormToken.value;
                }

                form.appendChild(token);
                document.body.appendChild(form);
                form.submit();
            }
        }
    </script>
}