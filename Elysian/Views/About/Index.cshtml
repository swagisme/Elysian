@{
    ViewData["Title"] = "About Us";
}

<section class="about-section container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5 text-dark">About <span class="text-rose">Elysian</span></h1>
        <p class="text-muted fs-5">Discover the story behind our jewellery and accessories.</p>
        <hr class="w-25 mx-auto border-3 border-primary" />
    </div>

    <div class="row align-items-center gy-5">
        <!-- Left Image -->
        <div class="col-md-6 text-center">
            <img src="~/images/about.jpg"
                 alt="About Elysian"
                 class="img-fluid rounded-4 shadow-lg"
                 style="max-height: 400px; object-fit: cover;" />
        </div>

        <!-- Right Text -->
        <div class="col-md-6">
            <div class="p-3">
                <h3 class="fw-semibold mb-3 text-rose">Our Story</h3>
                <p class="text-muted fs-6">
                    At <strong>Elysian</strong>, we believe jewellery is more than just an accessory —
                    it’s an expression of beauty, elegance, and timeless charm.
                    Our collections are carefully crafted to blend modern design with classic inspiration.
                </p>

                <h3 class="fw-semibold mt-4 mb-3 text-rose">Our Vision</h3>
                <p class="text-muted fs-6">
                    To bring premium jewellery to everyone who values elegance, authenticity, and craftsmanship.
                    We aim to create pieces that celebrate individuality and everlasting style.
                </p>
            </div>
        </div>
    </div>

    <!-- Highlight Section -->
    <div class="mt-5 text-center">
        <div class="p-4 bg-light rounded-4 shadow-sm">
            <h4 class="fw-bold text-dark">✨ Crafted with Love, Designed for Elegance ✨</h4>
            <p class="text-muted mb-0">
                Every Elysian piece tells a story of sophistication and passion.
            </p>
        </div>
    </div>
</section>
