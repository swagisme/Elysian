@model Elysian.Models.Product
@{
    ViewData["Title"] = Model.Name;
}

<div class="bg-[#f8f4f1] min-h-screen p-8">
    <div class="max-w-6xl mx-auto bg-white rounded-xl shadow-lg p-6 grid grid-cols-1 md:grid-cols-2 gap-8">

        <!-- Product Image -->
        <div>
            <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-auto object-cover rounded-xl shadow" />
        </div>

        <!-- Product Info -->
        <div>
            <h1 class="text-3xl font-bold mb-4">@Model.Name</h1>
            <p class="text-gray-600 text-sm mb-2">Category: @Model.Category</p>
            <p class="text-gold text-2xl font-bold mb-6">$@Model.Price</p>

            <p class="text-gray-700 leading-relaxed mb-6">
                @Model.Description
            </p>

            <div class="flex gap-4">
                <a href="/Cart/Add/@Model.Id" class="bg-gold hover:bg-yellow-500 text-white px-6 py-3 rounded-lg transition flex items-center gap-2">
                    <i class="fas fa-shopping-cart"></i> Add to Cart
                </a>
                <a href="/Shop" class="border border-gray-300 px-6 py-3 rounded-lg hover:bg-gray-100 transition">
                    Back to Shop
                </a>
            </div>
        </div>

    </div>
</div>
