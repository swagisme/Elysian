@model IEnumerable<Elysian.Models.Product>
@{
    ViewData["Title"] = "Shop";
}

<!-- Search and Filter Section -->
<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 py-3">
        <h1 class="fw-bold display-6" style="font-family:'Playfair Display', serif; color:#333;">
            ✨ Discover Your Shine
        </h1>
        <button id="filterBtn" class="btn btn-lg rounded-pill shadow-sm d-flex align-items-center gap-2"
                style="background:#DEB64B; color:#fff; border:none;" onclick="toggleSidebar()">
            <i class="fas fa-filter"></i> Filters
        </button>
    </div>

    <!-- Search Bar -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="search-container position-relative">
                <input type="text" id="searchInput" class="form-control form-control-lg rounded-pill shadow-sm border-0 ps-5"
                       placeholder="🔍 Search jewellery... (necklaces, rings, earrings)"
                       style="background:#f8f9fa; font-size:1.1rem;">
                <div class="position-absolute top-50 start-0 translate-middle-y ms-3">
                    <i class="fas fa-search text-muted"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Categories -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <button class="category-btn active rounded-pill px-4 py-2 border-0" data-category="all">
                    ✨ All Jewellery
                </button>
                @foreach (var cat in ViewBag.Categories)
                {
                    <button class="category-btn rounded-pill px-4 py-2 border-0" data-category="@cat.Category.ToLower()">
                        @GetCategoryIcon(cat.Category) @cat.Category
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sidebar - FIXED: Properly hidden with overlay -->
<div id="filterSidebar" class="sidebar shadow-lg">
    <div class="sidebar-header d-flex justify-content-between align-items-center border-bottom pb-3">
        <h4 class="fw-bold m-0" style="color:#DEB64B;">✨ Filters</h4>
        <button class="close-btn border-0 bg-transparent fs-2" style="color:#333;" onclick="toggleSidebar()">&times;</button>
    </div>

    <div class="sidebar-content py-3">
        <!-- Filter by Price -->
        <div class="filter-section mb-4">
            <h5 class="fw-semibold mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-tag" style="color:#DEB64B;"></i> Price Range
            </h5>
            <form method="get" asp-action="Index" class="price-filter">
                <div class="slider-container mb-3">
                    <div class="slider-track" style="background:#DEB64B; height:4px; border-radius:2px;"></div>
                    <input type="range" id="minPriceSlider" min="@ViewBag.MinPrice" max="@ViewBag.MaxPrice"
                           value="@ViewBag.MinPrice" class="form-range position-absolute"
                           style="width:100%; background:transparent;" />
                    <input type="range" id="maxPriceSlider" min="@ViewBag.MinPrice" max="@ViewBag.MaxPrice"
                           value="@ViewBag.MaxPrice" class="form-range position-absolute"
                           style="width:100%; background:transparent;" />
                </div>

                <input type="hidden" id="minPrice" name="minPrice" value="@ViewBag.MinPrice" />
                <input type="hidden" id="maxPrice" name="maxPrice" value="@ViewBag.MaxPrice" />

                <div class="price-values d-flex justify-content-between align-items-center mb-3">
                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                          style="background:#DEB64B; color:#fff;">Rs. <span id="minPriceVal">@ViewBag.MinPrice</span></span>
                    <span class="text-muted">to</span>
                    <span class="badge rounded-pill px-3 py-2 fw-semibold"
                          style="background:#DEB64B; color:#fff;">Rs. <span id="maxPriceVal">@ViewBag.MaxPrice</span></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn w-50 rounded-pill border-0 fw-semibold"
                            style="background:#DEB64B; color:#fff;">
                        Apply Filters
                    </button>
                    <a href="/Shop/Index" class="btn btn-outline-dark w-50 rounded-pill fw-semibold">Reset All</a>
                </div>
            </form>
        </div>

        <hr>

        <!-- Filter by Categories -->
        <div class="filter-section">
            <h5 class="fw-semibold mb-3 d-flex align-items-center gap-2">
                <i class="fas fa-gem" style="color:#DEB64B;"></i> Categories
            </h5>
            <ul class="list-unstyled category-list">
                @foreach (var cat in ViewBag.Categories)
                {
                    <li class="mb-2">
                        <a href="@Url.Action("Index", new { category = cat.Category })"
                           class="d-flex align-items-center text-decoration-none text-dark p-3 rounded-4 hover-shadow category-link"
                           style="transition:0.3s; background:#f8f9fa;">
                            <div class="category-icon me-3 d-flex align-items-center justify-content-center rounded-circle"
                                 style="width:40px; height:40px; background:#DEB64B;">
                                @GetCategoryEmoji(cat.Category)
                            </div>
                            <span class="fw-semibold flex-grow-1">@cat.Category</span>
                            <span class="badge rounded-pill px-3 py-2"
                                  style="background:#333; color:#fff;">@cat.Count</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>

<!-- Quick View Modal -->
<div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row">
                    <div class="col-md-6">
                        <img id="modalProductImage" src="" alt="" class="img-fluid rounded-3 w-100" style="height: 400px; object-fit: cover;">
                    </div>
                    <div class="col-md-6">
                        <div class="product-details">
                            <span class="badge rounded-pill px-3 py-2 mb-2" id="modalProductCategory"
                                  style="background: rgba(222, 182, 75, 0.1); color: #DEB64B; border: 1px solid rgba(222, 182, 75, 0.3);">
                            </span>
                            <h3 id="modalProductName" class="fw-bold mb-3" style="font-family:'Playfair Display', serif;"></h3>
                            <p id="modalProductDescription" class="text-muted mb-3"></p>

                            <div class="price-section mb-3">
                                <div class="fw-bold py-2 px-3 rounded-3 text-center"
                                     style="background: rgba(222, 182, 75, 0.1); color: #DEB64B; font-size: 1.5rem; border: 1px solid rgba(222, 182, 75, 0.2);">
                                    Rs. <span id="modalProductPrice"></span>
                                </div>
                            </div>

                            <div class="product-meta mb-4">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted">Rating:</span>
                                    <div class="rating" id="modalProductRating"></div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted">Material:</span>
                                    <span id="modalProductMaterial" class="fw-semibold"></span>
                                </div>
                            </div>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-4">
                                <input type="hidden" name="productId" id="modalProductId" />
                                <div class="d-flex gap-2 align-items-center">
                                    <div class="quantity-control d-flex align-items-center border rounded-pill px-3 bg-light me-2">
                                        <button type="button" class="btn btn-sm border-0 px-2 quantity-decrease">-</button>
                                        <input type="number" name="quantity" value="1" min="1"
                                               class="form-control border-0 text-center shadow-none bg-transparent fw-bold"
                                               style="width: 60px;" readonly />
                                        <button type="button" class="btn btn-sm border-0 px-2 quantity-increase">+</button>
                                    </div>
                                    <button type="submit" class="btn rounded-pill shadow-sm fw-semibold d-flex align-items-center gap-2 add-to-cart-btn"
                                            style="background:#DEB64B; color:white; border:none; padding: 10px 20px;">
                                        <i class="fas fa-shopping-cart"></i> Add to Cart
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Product Cards - FIXED: Proper category filtering and badge positioning -->
<div class="container-fluid px-4">
    <div class="row" id="productGrid">
        @foreach (var product in Model)
        {
            <div class="col-xl-3 col-lg-4 col-md-6 mb-4 product-card"
                 data-name="@product.Name.ToLower()"
                 data-category="@product.Category.ToLower()">
                <div class="card product-card-inner h-100 shadow-sm rounded-4 position-relative">

                    <!-- Image Wrapper -->
                    <div class="image-wrapper rounded-top-4 overflow-hidden position-relative">
                        <img src="@Url.Content(product.ImageUrl)" alt="@product.Name"
                             class="product-image w-100" style="height: 280px; object-fit: cover;">

                        <div class="image-overlay position-absolute top-0 start-0 w-100 h-100"
                             style="background: linear-gradient(to bottom, transparent 50%, rgba(0,0,0,0.3));"></div>

                        <!-- Status Badges (top-left on image) -->
                        <div class="badge-wrapper">
                            @if (product.IsFeatured)
                            {
                                <span class="badge-status featured">⭐ Featured</span>
                            }
                            @if (product.IsNewArrival)
                            {
                                <span class="badge-status new">🆕 New</span>
                            }
                        </div>

                        <!-- Quick Actions -->
                        <div class="quick-actions position-absolute bottom-0 start-0 end-0 d-flex justify-content-center gap-2 p-3">
                            <div class="d-flex justify-content-center gap-2">
                                <button class="btn btn-light rounded-circle shadow-sm quick-view-btn"
                                        style="width: 45px; height: 45px; background: rgba(255,255,255,0.9);"
                                        data-product-id="@product.Id"
                                        data-product-name="@product.Name"
                                        data-product-description="@product.Description"
                                        data-product-price="@product.Price"
                                        data-product-image="@product.ImageUrl"
                                        data-product-category="@product.Category"
                                        data-product-rating="@product.Rating"
                                        data-product-material="@product.Material">
                                    <i class="fas fa-eye" style="color:#DEB64B;"></i>
                                </button>

                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn rounded-pill shadow-sm fw-semibold d-flex align-items-center gap-2 add-to-cart-btn"
                                            style="background:#DEB64B; color:white; border:none; padding: 10px 20px;">
                                        <i class="fas fa-shopping-cart"></i> Add to Cart
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="card-body d-flex flex-column">
                        <!-- Category Badge -->
                        <span class="badge-category">
                            @GetCategoryIcon(product.Category) @product.Category
                        </span>

                        <!-- Product Name -->
                        <h5 class="fw-bold mb-2" style="line-height: 1.3; min-height: 2.6em;">
                            @product.Name
                        </h5>

                        <!-- Product Description -->
                        <p class="text-muted small mb-3 flex-grow-1" style="line-height: 1.5; min-height: 3em;">
                            @product.Description
                        </p>

                        <!-- Price Section -->
                        <div class="price-section mb-3">
                            Rs. @FormatPrice(product.Price)
                        </div>

                        <!-- Rating and Material -->
                        <div class="product-meta d-flex justify-content-between align-items-center mb-3">
                            <div class="rating d-flex align-items-center">
                                <div class="stars me-2">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= product.Rating ? "text-warning" : "text-light")" style="font-size: 0.9rem;"></i>
                                    }
                                </div>
                                <span class="text-muted small">(@product.Rating.ToString("0.0"))</span>
                            </div>

                            @if (!string.IsNullOrEmpty(product.Material))
                            {
                                <span class="badge bg-light text-dark rounded-pill px-3 py-2 small">
                                    <i class="fas fa-gem me-1" style="color:#DEB64B;"></i> @product.Material
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>


    <!-- No Results Message -->
    <div id="noResults" class="text-center py-5 d-none">
        <div class="mb-4">
            <i class="fas fa-search fa-3x text-muted mb-3"></i>
            <h4 class="fw-bold text-muted">No jewellery found</h4>
            <p class="text-muted">Try adjusting your search or filters</p>
        </div>
    </div>
</div>

@functions {
    public string GetCategoryIcon(string category)
    {
        var categoryLower = category.Trim().ToLower();
        if (categoryLower.Contains("earring")) return "💫";
        if (categoryLower.Contains("ring")) return "💍";
        if (categoryLower.Contains("necklace")) return "📿";
        return "✨";
    }

    public string GetCategoryEmoji(string category)
    {
        var categoryLower = category.Trim().ToLower();
        if (categoryLower.Contains("earring")) return "💫";
        if (categoryLower.Contains("ring")) return "💍";
        if (categoryLower.Contains("necklace")) return "📿";
        return "✨";
    }

    public string FormatPrice(decimal price)
    {
        if (price >= 100000)
        {
            return (price / 100000).ToString("0.0") + " Lakh";
        }
        else if (price >= 1000)
        {
            return (price / 1000).ToString("0") + "K";
        }
        return price.ToString("N0");
    }
}

<style>
    
    /* 📦 SIDEBAR STYLING */
   
    .sidebar {
        position: fixed;
        top: 0;
        right: -400px;
        width: 380px;
        height: 100%;
        background: #fff;
        box-shadow: -5px 0 25px rgba(0,0,0,0.1);
        padding: 0;
        z-index: 1060;
        transition: 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        overflow-y: auto;
        visibility: hidden;
    }

    .sidebar.active {
        right: 0;
        visibility: visible;
    }

    .sidebar-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 1055;
        display: none;
    }

    .sidebar-overlay.active {
        display: block;
    }


   /* 🖼️ PRODUCT IMAGE & WRAPPER */
.image-wrapper {
    position: relative;
    overflow: visible; /* Important: allow badges to show */
    border-top-left-radius: 1rem;
    border-top-right-radius: 1rem;
}

.product-image {
    width: 100%;
    height: 280px;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.product-card-inner {
    background: #fff;
    border: 1px solid rgba(222, 182, 75, 0.1);
    border-radius: 1rem;
    position: relative;
    transition: all 0.3s ease;
    overflow: visible;
}

.product-card-inner:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    border-color: rgba(222, 182, 75, 0.3);
}

.product-card-inner:hover .product-image {
    transform: scale(1.05);
}

    /* 🔹 Status Badges on Image */
    .badge-wrapper {
        position: absolute;
        top: 10px; /* distance from top of image */
        left: 10px; /* distance from left of image */
        display: flex;
        flex-direction: column;
        gap: 5px;
        z-index: 30;
    }

    /* Individual Status Badges */
    .badge-status {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 30px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
        color: #fff;
    }

        .badge-status.new {
            background: #28a745;
        }

        .badge-status.featured {
            background: linear-gradient(90deg, #e3c36f, #d1a744);
        }

    /* 🔹 Category Badge inside Card Body */
    .badge-category {
        font-size: 0.8rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 30px;
        background: rgba(255,255,255,0.95);
        color: #DEB64B;
        border: 1px solid rgba(222, 182, 75, 0.3);
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
        display: inline-block;
        margin-bottom: 8px;
    }


/* Quick Actions (Bottom Center) */
.quick-actions {
    position: absolute;
    bottom: 10px;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    z-index: 25;
}

.quick-view-btn, .add-to-cart-btn {
    transition: all 0.3s ease;
}

.quick-view-btn:hover, .add-to-cart-btn:hover {
    transform: scale(1.05);
}

/* Card Body */
.card-body {
    background: #fff;
    padding: 1rem;
}

.price-section {
    text-align: center;
    font-size: 1.2rem;
    font-weight: 700;
    color: #DEB64B;
    background: rgba(222, 182, 75, 0.1);
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
}

/* Stars */
.stars {
    display: flex;
    gap: 2px;
}

/* Responsive */
 
    @@media (max-width: 768px) {
        .product-card-inner img {
            height: 220px;
        }
    }
   
    .add-to-cart-btn {
        padding: 8px 16px;
        font-size: 0.9rem;
    }
}
</style>

<script>

    document.addEventListener('DOMContentLoaded', function () {
        const sidebar = document.getElementById('filterSidebar');
        const filterBtn = document.getElementById('filterBtn');
        let sidebarOverlay;

        const productCards = document.querySelectorAll('.product-card');
        const categoryBtns = document.querySelectorAll('.category-btn');
        const searchInput = document.getElementById('searchInput');
        const noResults = document.getElementById('noResults');

        // ===== Sidebar Toggle =====
        function createOverlay() {
            sidebarOverlay = document.createElement('div');
            sidebarOverlay.className = 'sidebar-overlay';
            sidebarOverlay.onclick = toggleSidebar;
            document.body.appendChild(sidebarOverlay);
        }

        function toggleSidebar() {
            sidebar.classList.toggle('active');
            if (sidebarOverlay) {
                sidebarOverlay.classList.toggle('active');
            } else {
                createOverlay();
                sidebarOverlay.classList.add('active');
            }
        }

        filterBtn.addEventListener('click', toggleSidebar);

        document.addEventListener('keydown', function (event) {
            if (event.key === 'Escape') {
                sidebar.classList.remove('active');
                if (sidebarOverlay) sidebarOverlay.classList.remove('active');
            }
        });

        // ===== Quick View Modal =====
        const quickViewModal = new bootstrap.Modal(document.getElementById('quickViewModal'));

        document.querySelectorAll('.quick-view-btn').forEach(btn => {
            btn.addEventListener('click', function (e) {
                e.preventDefault();
                const productId = this.getAttribute('data-product-id');
                const productName = this.getAttribute('data-product-name');
                const productDescription = this.getAttribute('data-product-description');
                const productPrice = this.getAttribute('data-product-price');
                const productImage = this.getAttribute('data-product-image');
                const productCategory = this.getAttribute('data-product-category');
                const productRating = parseFloat(this.getAttribute('data-product-rating'));
                const productMaterial = this.getAttribute('data-product-material');

                document.getElementById('modalProductId').value = productId;
                document.getElementById('modalProductName').textContent = productName;
                document.getElementById('modalProductDescription').textContent = productDescription;
                document.getElementById('modalProductPrice').textContent = formatPriceForDisplay(productPrice);
                document.getElementById('modalProductImage').src = productImage;
                document.getElementById('modalProductCategory').innerHTML = GetCategoryIcon(productCategory) + ' ' + productCategory;
                document.getElementById('modalProductMaterial').textContent = productMaterial || 'Not specified';

                // Star rating
                const ratingElement = document.getElementById('modalProductRating');
                ratingElement.innerHTML = '';
                for (let i = 1; i <= 5; i++) {
                    const star = document.createElement('i');
                    star.className = `fas fa-star ${i <= productRating ? 'text-warning' : 'text-light'}`;
                    ratingElement.appendChild(star);
                }
                const ratingText = document.createElement('span');
                ratingText.className = 'text-muted ms-2';
                ratingText.textContent = `(${productRating.toFixed(1)})`;
                ratingElement.appendChild(ratingText);

                quickViewModal.show();
            });
        });

        // ===== Category Icon Helper =====
        function GetCategoryIcon(category) {
            const categoryLower = category.toLowerCase();
            if (categoryLower.includes('earring')) return '💫';
            if (categoryLower.includes('ring')) return '💍';
            if (categoryLower.includes('necklace')) return '📿';
            return '✨';
        }

        // ===== Price Formatter =====
        function formatPriceForDisplay(price) {
            const numPrice = parseFloat(price);
            if (numPrice >= 100000) return (numPrice / 100000).toFixed(1) + ' Lakh';
            if (numPrice >= 1000) return (numPrice / 1000).toFixed(0) + 'K';
            return numPrice.toLocaleString();
        }

        // ===== CATEGORY BUTTON FILTERING =====
        categoryBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                categoryBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                filterProducts();
            });
        });

        // ===== SEARCH INPUT FILTERING =====
        searchInput.addEventListener('input', function () {
            filterProducts();
        });

        // ===== COMBINED FILTER FUNCTION =====
        function filterProducts() {
            const searchTerm = searchInput.value.toLowerCase().trim();
            const activeCategoryBtn = document.querySelector('.category-btn.active');
            const selectedCategory = activeCategoryBtn ? activeCategoryBtn.getAttribute('data-category') : 'all';
            let visibleCount = 0;

            productCards.forEach(card => {
                const name = card.getAttribute('data-name');
                const category = card.getAttribute('data-category');

                const matchesCategory = selectedCategory === 'all' || category === selectedCategory;
                const matchesSearch = !searchTerm || name.includes(searchTerm) || category.includes(searchTerm);

                if (matchesCategory && matchesSearch) {
                    card.style.display = 'block';
                    visibleCount++;
                } else {
                    card.style.display = 'none';
                }
            });

                if (visibleCount === 0) {
        noResults.classList.remove('d-none');
    } else {
        noResults.classList.add('d-none');
    }

        }

        // ===== Quantity Controls for Modal =====
        document.querySelectorAll('.quantity-control').forEach(control => {
            const decreaseBtn = control.querySelector('.quantity-decrease');
            const increaseBtn = control.querySelector('.quantity-increase');
            const input = control.querySelector('input');

            decreaseBtn.addEventListener('click', () => {
                if (parseInt(input.value) > 1) input.value = parseInt(input.value) - 1;
            });
            increaseBtn.addEventListener('click', () => input.value = parseInt(input.value) + 1);
        });
    });
    </script>