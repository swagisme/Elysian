@model Elysian.Models.Product

<div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition transform hover:-translate-y-1"
     data-category="@Model.Category"
     data-price="@Model.Price">

    <!-- Product Image -->
    <img src="@Model.ImageUrl" alt="@Model.Name" class="w-full h-48 object-cover" />

    <!-- Product Info -->
    <div class="p-4">
        <h3 class="text-lg font-semibold text-gray-800">@Model.Name</h3>
        <p class="text-sm text-gray-500 mb-2">@Model.Category</p>
        <p class="text-xl font-bold text-gray-900">@Model.Price.ToString("C")</p>

        <!-- Add to Cart Button -->
        <button class="mt-3 w-full bg-black text-white py-2 px-4 rounded-lg hover:bg-gray-800 transition">
            Add to Cart
        </button>
    </div>
</div>
